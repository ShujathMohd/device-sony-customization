cc_binary {
    name: "android.hardware.lights-service.sony_sdm845",
    relative_install_path: "hw",
    init_rc: ["lights-sony_sdm845.rc"],
    vintf_fragments: ["lights-sony_sdm845.xml"],
    vendor: true,
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.light-V1-ndk",
    ],
    srcs: [
        "Lights.cpp",
        "main.cpp",
    ],
    overrides: ["android.hardware.light@2.0-service.sony"],
}
